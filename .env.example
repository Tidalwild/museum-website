# =============================================================================
# ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to `.env.local` and fill in your own values:
#
#     cp .env.example .env.local
#
# `.env.local` is git-ignored, so your keys never end up in the repository.
#
# The site RUNS with none of these set — the booking form works and the
# confirmation email is printed to your terminal instead of being sent. Fill
# them in when you are ready to store real bookings and send real email.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Supabase dashboard → Project Settings → API
#
# Safe to expose (it is compiled into the browser bundle):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
#
# ⚠️  SECRET. Bypasses Row Level Security. Server-side only.
#     Never rename this to NEXT_PUBLIC_* and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email -------------------------------------------------------------------
# How the confirmation email is sent. One of:
#   console        print it to the terminal (default while developing)
#   resend         send it from this Next.js server via the Resend API
#   edge-function  hand it to supabase/functions/send-booking-confirmation
EMAIL_TRANSPORT=console

# Needed when EMAIL_TRANSPORT=resend. Get a key at https://resend.com (the free
# tier is plenty for a university museum).
RESEND_API_KEY=

# The "From" address. Until you have verified your own domain with Resend, use
# their sandbox sender — it can only deliver to your own account's address.
EMAIL_FROM="SYU History Museum <onboarding@resend.dev>"

# --- Site --------------------------------------------------------------------
# Used to build absolute links inside emails. Set this to the real domain in
# production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
